# Read by docker-compose.yml itself (not by the containers) — copy to .env
# next to docker-compose.yml and fill in.

# Public IPv4 of this VPS. mediasoup stamps this into the ICE candidates it
# hands out for screen-share transports, so viewers outside the host's LAN
# know where to send RTP. Leave empty to auto-detect the host's public IP
# (required in Docker — otherwise ICE announces 172.x and viewers see black).
MEDIASOUP_ANNOUNCED_IP=
