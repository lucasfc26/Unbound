# Read by docker-compose.yml itself (not by the containers) — copy to .env
# next to docker-compose.yml and fill in.

# Public IPv4 of this VPS. mediasoup stamps this into the ICE candidates it
# hands out for screen-share transports, so viewers outside the host's LAN
# know where to send RTP. Leave empty to auto-detect the host's public IP
# (required in Docker — otherwise ICE announces 172.x and viewers see black).
MEDIASOUP_ANNOUNCED_IP=

# TURN relay for the mic/camera P2P mesh (RTCHIBRIDO.mp princípio 10) — used
# when STUN alone isn't enough to connect two peers (symmetric NAT, locked-down
# firewall). TURN_SECRET is shared between the backend (generates short-lived
# credentials from it) and coturn's --static-auth-secret — pick a long random
# value. TURN_EXTERNAL_IP is this VPS's public IPv4, same as
# MEDIASOUP_ANNOUNCED_IP above. Leave both empty to run STUN-only.
TURN_SECRET=
TURN_EXTERNAL_IP=
