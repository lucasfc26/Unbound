VITE_API_URL=http://localhost:3000

# Public web origin for links meant to be opened by someone else (invite
# links, etc). Leave unset locally — falls back to the browser's own origin.
# Must be set for the desktop build (.env.production): under Tauri,
# window.location.origin is http://tauri.localhost, which is meaningless
# outside that one window.
VITE_PUBLIC_APP_URL=
