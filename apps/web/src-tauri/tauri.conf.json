{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Unbound",
  "version": "0.3.3",
  "identifier": "com.unbound.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Unbound",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwRjU5QTRBQjY0NDlFQTAKUldTZ25rUzJTcHIxNEFiNHp4bnYzRVhPQk9rWm5oclQzTDdjZEJWM3lEVjNkb2krZVRoaFpSelEK",
      "endpoints": [
        "https://unbound.maselcorp.com.br/uploads/releases/latest.json"
      ]
    }
  }
}
