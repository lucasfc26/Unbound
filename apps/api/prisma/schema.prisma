generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The generated Client (app runtime) connects via url — the unprivileged maselview_app
  // role, so RLS is actually enforced. `prisma migrate`/`db push` use directUrl instead
  // when it's set — the superuser role, since migrations need DDL privileges RLS has
  // nothing to do with.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

enum UserStatus {
  ONLINE
  IDLE
  DO_NOT_DISTURB
  INVISIBLE
  OFFLINE
}

enum ServerRole {
  OWNER
  ADMIN
  MODERATOR
  MEMBER
}

enum ChannelType {
  TEXT
  VOICE
  DM
}

enum ChannelVisibility {
  EVERYONE
  MODERATORS
  ADMINS
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  REJECTED
  BLOCKED
}

enum FriendRequestPrivacy {
  EVERYONE
  NOBODY
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  displayName  String
  email        String     @unique
  passwordHash String
  avatarUrl    String?
  status       UserStatus @default(OFFLINE)
  // Shareable code a friend can redeem to add this user without knowing their username.
  friendCode   String     @unique
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  ownedServers      Server[]       @relation("ServerOwner")
  serverMemberships ServerMember[]
  messages          Message[]
  createdInvites    Invitation[]

  friendshipsSent     Friendship[] @relation("FriendshipRequester")
  friendshipsReceived Friendship[] @relation("FriendshipAddressee")

  bansReceived ServerBan[] @relation("BannedUser")
  bansIssued   ServerBan[] @relation("BannedBy")

  settings UserSettings?

  channelMemberships ChannelMember[]

  @@map("users")
}

// One row per user, holding everything editable from Settings > Perfil / Privacidade /
// Notificações. Row-level security (see the hand-written SQL appended to this table's
// migration) restricts inserts/updates/deletes to the owning user's own row, identified by
// the "app.current_user_id" session variable the API sets per request — reads stay open
// since some fields here (customStatus, friendRequestPrivacy) must be legible to OTHER
// users' requests (profile display, friend-request gating), not just the owner.
model UserSettings {
  userId String @id

  // Perfil
  bio          String? @db.VarChar(190)
  pronouns     String? @db.VarChar(40)
  customStatus String? @db.VarChar(100)

  // Privacidade
  friendRequestPrivacy FriendRequestPrivacy @default(EVERYONE)
  shareTypingStatus    Boolean              @default(true)

  // Notificações
  desktopNotifications Boolean @default(true)
  notificationSound    Boolean @default(true)

  // Aparência
  theme        String @default("dark")
  customColors Json?
  density      String @default("normal")

  // Voz
  micGain               Int     @default(100)
  outputGain            Int     @default(100)
  noiseSuppressionMode  String  @default("auto")
  noiseGate             Int     @default(40)
  pushToTalkEnabled     Boolean @default(false)
  keybinds              Json?

  // Transmissão — perfil de mídia (codecs/bitrate de mic, câmera e tela) e
  // controle manual do compartilhamento de tela quando broadcastMode = "manual".
  mediaProfile            String @default("quality")
  broadcastMode           String @default("auto")
  broadcastResolution     String @default("720p")
  broadcastMaxBitrateKbps Int    @default(2000)
  broadcastFps            Int    @default(30)
  broadcastCodec          String @default("auto")
  broadcastTransport      String @default("auto")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model Server {
  id          String   @id @default(uuid())
  name        String
  description String?
  iconUrl     String?
  iconColor   String   @default("#7c6cff")
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User              @relation("ServerOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     ServerMember[]
  categories  ChannelCategory[]
  channels    Channel[]
  invitations Invitation[]
  bans        ServerBan[]

  @@map("servers")
}

model ServerBan {
  id         String   @id @default(uuid())
  serverId   String
  userId     String
  reason     String?
  bannedById String
  createdAt  DateTime @default(now())

  server   Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  user     User   @relation("BannedUser", fields: [userId], references: [id], onDelete: Cascade)
  bannedBy User   @relation("BannedBy", fields: [bannedById], references: [id], onDelete: Cascade)

  @@unique([serverId, userId])
  @@map("server_bans")
}

model ServerMember {
  id       String     @id @default(uuid())
  userId   String
  serverId String
  role     ServerRole @default(MEMBER)
  joinedAt DateTime   @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId])
  @@map("server_members")
}

model ChannelCategory {
  id       String @id @default(uuid())
  serverId String
  name     String
  position Int    @default(0)

  server   Server    @relation(fields: [serverId], references: [id], onDelete: Cascade)
  channels Channel[]

  @@map("channel_categories")
}

model Channel {
  id         String      @id @default(uuid())
  serverId   String?
  categoryId String?
  name       String
  type       ChannelType       @default(TEXT)
  visibility ChannelVisibility @default(EVERYONE)
  topic      String?
  position   Int         @default(0)
  // Canonical pair of participant ids ("low:high") so get-or-create of a DM is unique.
  dmKey      String?     @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  server   Server?          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  category ChannelCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  messages Message[]
  members  ChannelMember[]

  @@map("channels")
}

// Participants of a DM channel (server TEXT/VOICE channels use ServerMember instead).
model ChannelMember {
  id         String   @id @default(uuid())
  channelId  String
  userId     String
  lastReadAt DateTime @default(now())

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@map("channel_members")
}

model Message {
  id          String    @id @default(uuid())
  // Monotonic insertion order, used for sorting/pagination instead of createdAt:
  // two messages created within the same millisecond (e.g. a burst over
  // WebSocket) would otherwise tie on createdAt and sort non-deterministically.
  sequence    BigInt    @default(autoincrement())
  channelId   String
  authorId    String
  content     String
  replyToId   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  editedAt    DateTime?
  deletedAt   DateTime?
  // Snapshot of the first URL's metadata, fetched once by the backend and cached — not
  // re-derived from a live cache lookup on every read, so history stays stable over time.
  linkPreview Json?

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([channelId, sequence])
  @@map("messages")
}

model Friendship {
  id          String           @id @default(uuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@map("friendships")
}

model Invitation {
  id        String    @id @default(uuid())
  code      String    @unique
  serverId  String
  creatorId String
  createdAt DateTime  @default(now())
  expiresAt DateTime?
  maxUses   Int?
  uses      Int       @default(0)

  server  Server @relation(fields: [serverId], references: [id], onDelete: Cascade)
  creator User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("invitations")
}
