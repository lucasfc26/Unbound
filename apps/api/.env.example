DATABASE_URL=postgresql://maselview:maselview@localhost:5432/maselview
REDIS_URL=redis://localhost:6379
JWT_SECRET=changeme
JWT_REFRESH_SECRET=changeme_refresh
PORT=3000
FRONTEND_URL=http://localhost:5173

# mediasoup (SFU screen share) — leave MEDIASOUP_ANNOUNCED_IP empty locally
# (loopback / auto-detect). In production/Docker set it to the server's public
# IPv4, or leave empty to auto-detect. An unset value inside Docker announces
# 172.x and remote viewers get a black screen.
MEDIASOUP_ANNOUNCED_IP=
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=40049

# TURN (mic/camera P2P fallback) — shared secret with the coturn service's
# --static-auth-secret. Leave both empty to run STUN-only (fine for two
# peers with an open NAT; calls between peers behind a symmetric NAT or a
# locked-down firewall will just fail to connect without this).
TURN_SECRET=
TURN_HOST=
TURN_PORT=3478
